{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm demo:build",
  "outputDirectory": "packages/demo-react/dist",
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api?route=:route*"
    }
  ]
}
